# Set this to the station's verified public audio streaming endpoint.
# Leave empty to keep the player in its unavailable preview state.
NEXT_PUBLIC_RADIO_STREAM_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Defaults to true in development and false in production.
# Set true only for a design preview, never a live newsroom.
ADUKE_DEMO_CONTENT=
# Persistent filesystem location for single-process hosting.
# Back up this directory together with public/uploads.
ADUKE_DATA_DIR=

# Vercel/serverless: run supabase/setup.sql, then set these SERVER-ONLY values.
# Never prefix the service role key with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_UPLOAD_BUCKET=aduke-uploads

# Optional server-only service for source-linked original news briefs.
GEMINI_API_KEY=
GEMINI_IMPORT_MODEL=gemini-3.5-flash-lite

# Private Vercel cron authorization token for daily newsroom research.
# Set the same random value in the Vercel Production environment and redeploy.
CRON_SECRET=
